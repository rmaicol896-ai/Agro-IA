{
  "name": "@agroia/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:express --external:cors --external:dotenv --external:zod --outdir=dist",
    "start": "node dist/index.js",
    "seed": "tsx src/seed-cli.ts",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@agroia/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
